{
  "name": "sdd",
  "displayName": "SDD",
  "description": "VS Code integration for the SDD coding agent — sidebar dashboard, @sdd chat participant, activity feed, conversation history, code lens, session forking, slash command completion, workflow controls, and 33 commands",
  "publisher": "bhargavvc",
  "version": "0.3.1",
  "icon": "logo.jpg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhargavvc/sdd"
  },
  "homepage": "https://github.com/bhargavvc/sdd/blob/main/vscode-extension/README.md",
  "bugs": {
    "url": "https://github.com/bhargavvc/sdd/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "coding",
    "sdd",
    "chat",
    "automation",
    "claude",
    "openai",
    "llm"
  ],
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sdd.start",
        "title": "SDD: Start Agent"
      },
      {
        "command": "sdd.stop",
        "title": "SDD: Stop Agent"
      },
      {
        "command": "sdd.newSession",
        "title": "SDD: New Session"
      },
      {
        "command": "sdd.sendMessage",
        "title": "SDD: Send Message"
      },
      {
        "command": "sdd.cycleModel",
        "title": "SDD: Cycle Model"
      },
      {
        "command": "sdd.cycleThinking",
        "title": "SDD: Cycle Thinking Level"
      },
      {
        "command": "sdd.compact",
        "title": "SDD: Compact Context"
      },
      {
        "command": "sdd.abort",
        "title": "SDD: Abort Current Operation"
      },
      {
        "command": "sdd.exportHtml",
        "title": "SDD: Export Conversation as HTML"
      },
      {
        "command": "sdd.sessionStats",
        "title": "SDD: Show Session Stats"
      },
      {
        "command": "sdd.runBash",
        "title": "SDD: Run Bash Command"
      },
      {
        "command": "sdd.switchModel",
        "title": "SDD: Switch Model"
      },
      {
        "command": "sdd.setThinking",
        "title": "SDD: Set Thinking Level"
      },
      {
        "command": "sdd.steer",
        "title": "SDD: Steer Agent"
      },
      {
        "command": "sdd.listCommands",
        "title": "SDD: List Available Commands"
      },
      {
        "command": "sdd.explain",
        "title": "SDD: Explain Code"
      },
      {
        "command": "sdd.fix",
        "title": "SDD: Fix Code"
      },
      {
        "command": "sdd.addTests",
        "title": "SDD: Add Tests"
      },
      {
        "command": "sdd.refactor",
        "title": "SDD: Refactor Code"
      },
      {
        "command": "sdd.optimize",
        "title": "SDD: Optimize Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sdd.refreshSessions",
          "when": "view == sdd-sessions",
          "group": "navigation"
        },
        {
          "command": "sdd.clearActivity",
          "when": "view == sdd-activity",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "submenu": "sdd.contextMenu",
          "group": "1_sdd",
          "when": "editorHasSelection"
        }
      ],
      "sdd.contextMenu": [
        {
          "command": "sdd.explain"
        },
        {
          "command": "sdd.fix"
        },
        {
          "command": "sdd.addTests"
        },
        {
          "command": "sdd.refactor"
        },
        {
          "command": "sdd.optimize"
        }
      ]
    },
    "submenus": [
      {
        "command": "sdd.refreshSessions",
        "title": "SDD: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "sdd.clearFileDecorations",
        "title": "SDD: Clear File Decorations"
      },
      {
        "command": "sdd.showHistory",
        "title": "SDD: Show Conversation History"
      },
      {
        "command": "sdd.askAboutSymbol",
        "title": "SDD: Ask About Symbol"
      },
      {
        "command": "sdd.clearActivity",
        "title": "SDD: Clear Activity Feed",
        "icon": "$(clear-all)"
      },
      {
        "command": "sdd.forkSession",
        "title": "SDD: Fork Session"
      },
      {
        "command": "sdd.toggleSteeringMode",
        "title": "SDD: Toggle Steering Mode"
      },
      {
        "command": "sdd.toggleFollowUpMode",
        "title": "SDD: Toggle Follow-Up Mode"
      },
      {
        "command": "sdd.refactorSymbol",
        "title": "SDD: Refactor Symbol"
      },
      {
        "command": "sdd.findBugsSymbol",
        "title": "SDD: Find Bugs in Symbol"
      },
      {
        "command": "sdd.generateTestsSymbol",
        "title": "SDD: Generate Tests for Symbol"
      },
      {
        "command": "sdd.acceptAllChanges",
        "title": "SDD: Accept All Agent Changes",
        "icon": "$(check-all)"
      },
      {
        "command": "sdd.discardAllChanges",
        "title": "SDD: Discard All Agent Changes",
        "icon": "$(discard)"
      },
      {
        "command": "sdd.acceptFileChanges",
        "title": "Accept Changes",
        "icon": "$(check)"
      },
      {
        "command": "sdd.discardFileChanges",
        "title": "Discard Changes",
        "icon": "$(discard)"
      },
      {
        "command": "sdd.restoreCheckpoint",
        "title": "SDD: Restore Checkpoint"
      },
      {
        "command": "sdd.fixProblemsInFile",
        "title": "SDD: Fix Problems in File"
      },
      {
        "command": "sdd.fixAllProblems",
        "title": "SDD: Fix All Problems"
      },
      {
        "command": "sdd.clearDiagnostics",
        "title": "SDD: Clear Agent Diagnostics"
      },
      {
        "command": "sdd.commitAgentChanges",
        "title": "SDD: Commit Agent Changes"
      },
      {
        "command": "sdd.createAgentBranch",
        "title": "SDD: Create Branch for Agent Work"
      },
      {
        "command": "sdd.showAgentDiff",
        "title": "SDD: Show Agent Diff"
      },
      {
        "command": "sdd.clearPlan",
        "title": "SDD: Clear Plan View",
        "icon": "$(clear-all)"
      },
      {
        "command": "sdd.cycleApprovalMode",
        "title": "SDD: Cycle Approval Mode"
      },
      {
        "command": "sdd.selectApprovalMode",
        "title": "SDD: Select Approval Mode"
      }
    ],
    "keybindings": [
      {
        "command": "sdd.newSession",
        "key": "ctrl+shift+g ctrl+shift+n",
        "mac": "cmd+shift+g cmd+shift+n"
      },
      {
        "command": "sdd.cycleModel",
        "key": "ctrl+shift+g ctrl+shift+m",
        "mac": "cmd+shift+g cmd+shift+m"
      },
      {
        "command": "sdd.cycleThinking",
        "key": "ctrl+shift+g ctrl+shift+t",
        "mac": "cmd+shift+g cmd+shift+t"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sdd",
          "title": "SDD",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "sdd": [
        {
          "type": "webview",
          "id": "sdd-sidebar",
          "name": "SDD Agent"
        },
        {
          "id": "sdd-sessions",
          "name": "Sessions"
        },
        {
          "id": "sdd-activity",
          "name": "Activity"
        },
        {
          "id": "sdd-plan",
          "name": "Plan"
        },
        {
          "id": "sdd-checkpoints",
          "name": "Checkpoints"
        }
      ],
      "scm/title": [
        {
          "command": "sdd.acceptAllChanges",
          "group": "navigation",
          "when": "scmProvider == sdd"
        },
        {
          "command": "sdd.discardAllChanges",
          "group": "navigation",
          "when": "scmProvider == sdd"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "sdd.acceptFileChanges",
          "group": "inline",
          "when": "scmProvider == sdd"
        },
        {
          "command": "sdd.discardFileChanges",
          "group": "inline",
          "when": "scmProvider == sdd"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "sdd.agent",
        "name": "sdd",
        "fullName": "SDD Agent",
        "description": "SDD coding agent",
        "isSticky": true
      }
    ],
    "configuration": {
      "title": "SDD",
      "properties": {
        "sdd.binaryPath": {
          "type": "string",
          "default": "sdd",
          "description": "Path to the SDD binary"
        },
        "sdd.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start the SDD agent when the extension activates"
        },
        "sdd.autoCompaction": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic context compaction"
        },
        "sdd.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show 'Ask SDD' code lens above functions and classes"
        },
        "sdd.showProgressNotifications": {
          "type": "boolean",
          "default": false,
          "description": "Show progress notification while the agent is working"
        },
        "sdd.activityFeedMaxItems": {
          "type": "number",
          "default": 100,
          "minimum": 10,
          "maximum": 500,
          "description": "Maximum number of items shown in the Activity feed"
        },
        "sdd.showContextWarning": {
          "type": "boolean",
          "default": true,
          "description": "Warn when context window usage exceeds the threshold"
        },
        "sdd.contextWarningThreshold": {
          "type": "number",
          "default": 80,
          "minimum": 50,
          "maximum": 95,
          "description": "Context window usage percentage that triggers a warning"
        },
        "sdd.approvalMode": {
          "type": "string",
          "default": "auto-approve",
          "enum": [
            "auto-approve",
            "ask",
            "plan-only"
          ],
          "enumDescriptions": [
            "Agent runs freely without prompts",
            "Prompt before file changes and commands",
            "Read-only mode — agent can analyze but not modify"
          ],
          "description": "Approval mode for agent actions"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.7.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.0"
  }
}
