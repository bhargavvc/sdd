{
  "name": "@bhargavvc/sdd-cursor",
  "version": "1.2.0",
  "description": "SDD framework MCP server for Cursor — zero Anthropic dependency",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhargavvc/sdd.git",
    "directory": "packages/cursor-mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sdd-cursor-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const{cpSync}=require('fs');cpSync('src/resources','dist/resources',{recursive:true})\"",
    "dev": "tsc --watch",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "cursorrules-template.md",
    "cursor-mcp-config.json",
    "SDD-NEW-CHAT.md",
    "SDD-TEAM-GUIDE.md",
    "src/resources"
  ]
}
